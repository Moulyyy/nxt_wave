# Gemini AI API Key (Required for audio transcription, multimodal reasoning, and dynamic pitch generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token (Optional: Get this from @BotFather in 30 seconds for live Telegram Sales alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Web Server Port (Defaults to 3000 locally, 10000 on Render)
PORT=3000
